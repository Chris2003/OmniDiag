<!--
    The window shell. Not a Window: OmniDiagGui.psm1 first shows a code-built frame window
    (New-OmniFrameWindow, no XAML), then parses this file at Background priority and makes
    this Grid the frame's Content (Complete-OmniShellLoad). Window-level settings (title,
    size, font, background, AutomationProperties) are set on the frame in code; the
    resources and KeyBindings below are moved onto the frame window when the shell loads,
    so shortcuts work wherever focus is. x:Names are looked up on this root's name scope.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="OmniShellRoot">

    <!--
        Keyboard shortcuts. Every binding raises NavigationCommands.GoToPage with a
        CommandParameter naming the action; OmniDiagGui.psm1 attaches one CommandBinding
        that dispatches on the parameter (Invoke-OmniShortcut). Keep this list in sync with
        $script:OmniShortcutHelp and docs/GUI.md.
    -->
    <Grid.InputBindings>
        <KeyBinding Key="F5" Command="NavigationCommands.GoToPage" CommandParameter="Scan"/>
        <KeyBinding Key="Escape" Command="NavigationCommands.GoToPage" CommandParameter="Cancel"/>
        <KeyBinding Key="E" Modifiers="Control" Command="NavigationCommands.GoToPage" CommandParameter="Export"/>
        <KeyBinding Key="F" Modifiers="Control" Command="NavigationCommands.GoToPage" CommandParameter="Find"/>
        <KeyBinding Key="T" Modifiers="Alt" Command="NavigationCommands.GoToPage" CommandParameter="Theme"/>
        <KeyBinding Key="F1" Command="NavigationCommands.GoToPage" CommandParameter="Help"/>
        <KeyBinding Key="D1" Modifiers="Control" Command="NavigationCommands.GoToPage" CommandParameter="Nav1"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="NavigationCommands.GoToPage" CommandParameter="Nav2"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="NavigationCommands.GoToPage" CommandParameter="Nav3"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="NavigationCommands.GoToPage" CommandParameter="Nav4"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="NavigationCommands.GoToPage" CommandParameter="Nav5"/>
        <KeyBinding Key="D6" Modifiers="Control" Command="NavigationCommands.GoToPage" CommandParameter="Nav6"/>
        <KeyBinding Key="D7" Modifiers="Control" Command="NavigationCommands.GoToPage" CommandParameter="Nav7"/>
        <KeyBinding Key="D8" Modifiers="Control" Command="NavigationCommands.GoToPage" CommandParameter="Nav8"/>
        <KeyBinding Key="D9" Modifiers="Control" Command="NavigationCommands.GoToPage" CommandParameter="Nav9"/>
    </Grid.InputBindings>

    <Grid.Resources>
        <!-- Brushes are set in code (Set-OmniTheme) on the frame window for dark/light/high
             contrast; the window's brushes win when this shell loads, so these Light-palette
             defaults only serve a standalone parse (designer, tests). In high contrast every
             key maps to a SystemColors brush. -->
        <SolidColorBrush x:Key="BrushWindowBg"   Color="#F5F7FA"/>
        <SolidColorBrush x:Key="BrushPanel"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushPanel2"     Color="#EEF1F5"/>
        <SolidColorBrush x:Key="BrushText"       Color="#1A1F24"/>
        <SolidColorBrush x:Key="BrushMuted"      Color="#5A6472"/>
        <SolidColorBrush x:Key="BrushAccent"     Color="#0969DA"/>
        <SolidColorBrush x:Key="BrushAccentText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushLine"       Color="#D5DBE2"/>
        <SolidColorBrush x:Key="BrushFocus"      Color="#1A1F24"/>
        <SolidColorBrush x:Key="BrushHover"      Color="#0969DA"/>
        <SolidColorBrush x:Key="BrushDisabled"   Color="#8C959F"/>
        <SolidColorBrush x:Key="BrushSevCritical" Color="#C4282D"/>
        <SolidColorBrush x:Key="BrushSevError"    Color="#B35A00"/>
        <SolidColorBrush x:Key="BrushSevWarning"  Color="#8A5A00"/>
        <SolidColorBrush x:Key="BrushSevPass"     Color="#1A7F37"/>

        <!-- Keyboard focus cue: a 2px dotted rectangle in BrushFocus (visible in every theme). -->
        <Style x:Key="OmniFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" Stroke="{DynamicResource BrushFocus}" StrokeThickness="2"
                                   StrokeDashArray="1 1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushPanel2}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource OmniFocusVisual}"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushFocus}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                                <Setter Property="Background" Value="{DynamicResource BrushPanel2}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action buttons. Colors come from setters (not local values) so the
             template's disabled trigger can still grey them out. -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource OmniFocusVisual}"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OmniFocusVisual}"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OmniFocusVisual}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Data grid, row, and detail-box styles are only used by the lazily loaded sections,
             so they live in Sections/SectionStyles.xaml and are merged in on first use. -->
    </Grid.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="OmniDiag" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="One Tool. Complete Diagnostics." Foreground="{DynamicResource BrushMuted}" Margin="12,0,0,0" VerticalAlignment="Bottom"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkNetworkProbes" Content="Run connectivity probes (contacts the network)" IsChecked="False"
                              VerticalAlignment="Center" Margin="0,4,12,4" TabIndex="1"
                              AutomationProperties.Name="Run connectivity probes (contacts the network)"
                              AutomationProperties.HelpText="Off by default. When on, some scanners contact the default gateway, a public DNS server, and the domain controller."
                              ToolTip="Off by default. When on, the Network, DNS Resolver, and Active Directory scanners ping the default gateway and 1.1.1.1, resolve www.microsoft.com, and check the domain secure channel."/>
                    <Label Content="Time _window" Target="{Binding ElementName=CmbRange}"/>
                    <ComboBox x:Name="CmbRange" Width="130" Margin="0,4,8,4" VerticalContentAlignment="Center" TabIndex="2"
                              AutomationProperties.Name="Event time window"
                              AutomationProperties.HelpText="How far back event-log scanners look."
                              ToolTip="How far back event-log scanners look (Alt+W)">
                        <ComboBoxItem Content="Last 24 Hours"/>
                        <ComboBoxItem Content="Last 7 Days" IsSelected="True"/>
                        <ComboBoxItem Content="Last 30 Days"/>
                    </ComboBox>
                    <Button x:Name="BtnScan" Content="Run _Scan" Style="{StaticResource AccentButton}" TabIndex="3" Margin="0,4,8,4"
                            AutomationProperties.Name="Run scan"
                            AutomationProperties.AcceleratorKey="F5"
                            AutomationProperties.HelpText="Runs the enabled diagnostic scanners in the background."
                            ToolTip="Run a diagnostic scan (F5)"/>
                    <Button x:Name="BtnCancel" Content="_Cancel" IsEnabled="False" TabIndex="4" Margin="0,4,8,4"
                            AutomationProperties.Name="Cancel scan"
                            AutomationProperties.AcceleratorKey="Escape"
                            ToolTip="Cancel the running scan or repair (Esc)"/>
                    <Button x:Name="BtnExport" Content="_Export Report" IsEnabled="False" TabIndex="5" Margin="0,4,8,4"
                            AutomationProperties.Name="Export report"
                            AutomationProperties.AcceleratorKey="Ctrl+E"
                            AutomationProperties.HelpText="Writes the latest scan to report files on this computer."
                            ToolTip="Export the latest scan as reports (Ctrl+E)"/>
                    <Button x:Name="BtnTheme" Content="Dark Mode" TabIndex="6" Margin="0,4,8,4"
                            AutomationProperties.Name="Switch to dark theme"
                            AutomationProperties.AcceleratorKey="Alt+T"
                            ToolTip="Toggle dark or light theme (Alt+T)"/>
                    <Button x:Name="BtnHelp" Content="?" TabIndex="7" Margin="0,4,0,4" Padding="12,7" MinWidth="34"
                            AutomationProperties.Name="Keyboard shortcuts and help"
                            AutomationProperties.AcceleratorKey="F1"
                            ToolTip="Keyboard shortcuts and help (F1)"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Body: left nav + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,1,0">
                <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource BrushText}" Margin="6"
                         TabIndex="10" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"
                         AutomationProperties.Name="Sections"
                         AutomationProperties.HelpText="Use the Up and Down arrow keys to switch sections, or Ctrl+1 to Ctrl+6.">
                    <ListBoxItem Content="Dashboard" Tag="PanelDashboard" IsSelected="True"
                                 AutomationProperties.Name="Dashboard" AutomationProperties.AcceleratorKey="Ctrl+1"/>
                    <ListBoxItem Content="Groups" Tag="PanelGroups"
                                 AutomationProperties.Name="Groups" AutomationProperties.AcceleratorKey="Ctrl+2"/>
                    <ListBoxItem Content="All Findings" Tag="PanelFindings"
                                 AutomationProperties.Name="All Findings" AutomationProperties.AcceleratorKey="Ctrl+3"/>
                    <ListBoxItem Content="Diagnostics" Tag="PanelDiagnostics"
                                 AutomationProperties.Name="Diagnostics" AutomationProperties.AcceleratorKey="Ctrl+4"/>
                    <ListBoxItem Content="Repair Center" Tag="PanelRepair"
                                 AutomationProperties.Name="Repair Center" AutomationProperties.AcceleratorKey="Ctrl+5"/>
                    <ListBoxItem Content="Local AI" Tag="PanelLocalAi"
                                 AutomationProperties.Name="Local AI" AutomationProperties.AcceleratorKey="Ctrl+6"/>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="16">
                <!-- Dashboard panel -->
                <ScrollViewer x:Name="PanelDashboard" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Dashboard">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="22,16" Margin="0,0,16,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtScore" Text="--" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtGrade" Text="Not scanned" Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtComputer" Text="Computer: -"/>
                                <TextBlock x:Name="TxtUser" Text="User: -" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtRange" Text="Range: -" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtDuration" Text="Duration: -" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtCounts" Text="Run a scan to see results." Margin="0,8,0,0" Foreground="{DynamicResource BrushMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="System Information" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,8"/>
                        <Border Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel x:Name="PanelSysInfo" AutomationProperties.Name="System information">
                                <TextBlock Text="Loading system information..." Foreground="{DynamicResource BrushMuted}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Top Recommendations" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,8"/>
                        <ItemsControl x:Name="ItemsRecommendations" AutomationProperties.Name="Top recommendations">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Recommendation}" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Module Results" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8"/>
                        <!-- Module Results grid (Sections/DashboardModules.xaml): loaded right after first paint. -->
                        <Border x:Name="PanelDashboardModules"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- The other sections are XAML fragments in Sections/*.xaml, parsed on first
                     navigation into these hosts (Import-OmniSection in OmniDiagGui.psm1) and
                     cached. Collapsed, empty hosts cost nothing at startup. -->
                <Border x:Name="PanelGroups" Visibility="Collapsed"/>
                <Border x:Name="PanelFindings" Visibility="Collapsed"/>
                <Border x:Name="PanelDiagnostics" Visibility="Collapsed"/>
                <Border x:Name="PanelRepair" Visibility="Collapsed"/>
                <Border x:Name="PanelLocalAi" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- Status bar. Screen-reader live regions (LiveSetting=Polite) are applied to
             TxtStatus and ProgressBarMain in code (Enable-OmniLiveRegion) so the XAML still
             loads on .NET Framework builds older than 4.7.1. -->
        <Border Grid.Row="2" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Ready." VerticalAlignment="Center" Foreground="{DynamicResource BrushMuted}"
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="ProgressBarMain" Grid.Column="1" Height="14" Minimum="0" Maximum="100" Value="0"
                             AutomationProperties.Name="Progress"/>
            </Grid>
        </Border>
    </Grid>
</Grid>
