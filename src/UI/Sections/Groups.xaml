<!--
    Groups section: per-group summary with drill-down. Loaded on first navigation into
    PanelGroups (MainWindow.xaml).
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="GroupListView">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Groups" FontSize="20" FontWeight="Bold"/>
            <DockPanel Margin="0,4,0,0" LastChildFill="True">
                <Button x:Name="BtnGroupOpen" DockPanel.Dock="Right" Content="Open selected _group" Margin="8,0,0,0"
                        AutomationProperties.Name="Open selected group"
                        ToolTip="Show the modules and findings in the selected group (Enter)"/>
                <TextBlock x:Name="TxtGroupsHint" TextWrapping="Wrap" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"
                           Text="Each v1.0 module group with its status after a scan. Select a group and press Enter (or double-click) to see its modules and findings."/>
            </DockPanel>
        </StackPanel>
        <DataGrid x:Name="GridGroups" Grid.Row="1" RowStyle="{DynamicResource NamedRowStyle}"
                  AutomationProperties.Name="Module groups"
                  AutomationProperties.HelpText="Press Enter to open the selected group.">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Group" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="Auto"/>
                <DataGridTextColumn Header="Worst severity" Binding="{Binding Worst}" Width="Auto"/>
                <DataGridTextColumn Header="Critical" Binding="{Binding Critical}" Width="Auto"/>
                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="Auto"/>
                <DataGridTextColumn Header="Warning" Binding="{Binding Warning}" Width="Auto"/>
                <DataGridTextColumn Header="Scanners" Binding="{Binding Scanners}" Width="Auto"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

    <Grid x:Name="GroupDetailView" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <Button x:Name="BtnGroupBack" DockPanel.Dock="Left" Content="_Back to groups"
                    AutomationProperties.Name="Back to groups"
                    AutomationProperties.AcceleratorKey="Alt+Left"
                    ToolTip="Return to the group list (Alt+Left or Backspace)"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtGroupTitle" Text="Group" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="TxtGroupSummary" Text="" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="GridGroupModules" Grid.Row="1" MaxHeight="170" Margin="0,0,0,8" RowStyle="{DynamicResource NamedRowStyle}"
                  AutomationProperties.Name="Modules in this group">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="2*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Findings" Binding="{Binding Findings}" Width="Auto"/>
                <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMs}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid x:Name="GridGroupFindings" Grid.Row="2" RowStyle="{DynamicResource FindingRowStyle}"
                  AutomationProperties.Name="Findings in this group"
                  AutomationProperties.HelpText="Press Enter to read the selected finding's details.">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="Auto"/>
                <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="*"/>
                <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="*"/>
                <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="Finding details" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <TextBox x:Name="TxtGroupFindingDetail" Grid.Row="4" Style="{DynamicResource DetailTextBox}"
                 Text="Select a finding to see its details."
                 AutomationProperties.Name="Finding details"/>
    </Grid>
</Grid>
